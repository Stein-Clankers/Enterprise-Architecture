{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stein-clankers.github.io/Enterprise-Architecture/schema/archipelago-workspace.schema.json",
  "title": "Archipelago workspace",
  "description": "Canonical native format of an Archipelago workspace: an ArchiMate 3.2 model plus the portfolio profile overlay. Written with sorted keys and deterministic array order so that two exports of the same model are byte-identical.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "elements",
    "relationships"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Format version. This build writes 6."
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "documentation": {
      "type": "string",
      "description": "What the model is for. The exchange format's model documentation, where Archi writes a model's purpose."
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "views": {
      "type": "array",
      "description": "Hand-drawn diagrams. (Schema 1 used this key for saved reports.)",
      "items": {
        "$ref": "#/$defs/view"
      }
    },
    "folders": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/folder"
      }
    },
    "reports": {
      "type": "array",
      "description": "Saved report definitions.",
      "items": {
        "$ref": "#/$defs/report"
      }
    },
    "tagGroups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tagGroup"
      }
    },
    "propertyTypes": {
      "type": "object",
      "description": "Exchange-format types declared for property keys held here as text (currency, date, time), so a model that arrives typed leaves typed. Keys whose type the value itself carries (boolean, number) are not listed.",
      "additionalProperties": {
        "enum": [
          "boolean",
          "currency",
          "date",
          "number",
          "time"
        ]
      }
    },
    "language": {
      "type": "string",
      "description": "The language the texts are written in, as an xml:lang tag. Absent means en. An exchange-format export labels every text with it.",
      "pattern": "^[a-zA-Z]{1,8}(-[a-zA-Z0-9]{1,8})*$"
    }
  },
  "$defs": {
    "element": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable identifier. Must be usable as an xs:ID so the model survives an exchange-format round trip.",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
        },
        "type": {
          "enum": [
            "Resource",
            "Capability",
            "CourseOfAction",
            "ValueStream",
            "BusinessActor",
            "BusinessRole",
            "BusinessCollaboration",
            "BusinessInterface",
            "BusinessProcess",
            "BusinessFunction",
            "BusinessInteraction",
            "BusinessEvent",
            "BusinessService",
            "BusinessObject",
            "Contract",
            "Representation",
            "Product",
            "ApplicationComponent",
            "ApplicationCollaboration",
            "ApplicationInterface",
            "ApplicationFunction",
            "ApplicationInteraction",
            "ApplicationProcess",
            "ApplicationEvent",
            "ApplicationService",
            "DataObject",
            "Node",
            "Device",
            "SystemSoftware",
            "TechnologyCollaboration",
            "TechnologyInterface",
            "Path",
            "CommunicationNetwork",
            "TechnologyFunction",
            "TechnologyProcess",
            "TechnologyInteraction",
            "TechnologyEvent",
            "TechnologyService",
            "Artifact",
            "Equipment",
            "Facility",
            "DistributionNetwork",
            "Material",
            "Stakeholder",
            "Driver",
            "Assessment",
            "Goal",
            "Outcome",
            "Principle",
            "Requirement",
            "Constraint",
            "Meaning",
            "Value",
            "WorkPackage",
            "Deliverable",
            "ImplementationEvent",
            "Plateau",
            "Gap",
            "Location",
            "Grouping",
            "Junction"
          ]
        },
        "name": {
          "type": "string"
        },
        "documentation": {
          "type": "string"
        },
        "junctionKind": {
          "enum": [
            "and",
            "or"
          ],
          "description": "And/or flavour of a Junction, which the exchange format spells as two concrete types (AndJunction, OrJunction). Absent means \"and\". Meaningless on any other element type."
        },
        "properties": {
          "$ref": "#/$defs/properties"
        },
        "profile": {
          "$ref": "#/$defs/portfolioProfile"
        },
        "plan": {
          "$ref": "#/$defs/plan"
        },
        "folder": {
          "$ref": "#/$defs/folderRef"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "plan"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "WorkPackage"
              }
            }
          }
        }
      ]
    },
    "plan": {
      "description": "A Work Package's plan profile: a rollout with its site plans, or one of its waves. Only a Work Package carries one.",
      "oneOf": [
        {
          "$ref": "#/$defs/rolloutPlan"
        },
        {
          "$ref": "#/$defs/wavePlan"
        }
      ]
    },
    "planDate": {
      "type": "object",
      "description": "A date with a precision. date is the first day of the period: of the quarter or month, the Monday of the ISO week, or the day itself.",
      "required": [
        "date",
        "precision"
      ],
      "additionalProperties": false,
      "properties": {
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "precision": {
          "enum": [
            "quarter",
            "month",
            "week",
            "day"
          ]
        }
      }
    },
    "anchoredDate": {
      "type": "object",
      "description": "A milestone of the rollout plus whole days; negative is before it.",
      "required": [
        "anchor",
        "offsetDays"
      ],
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "type": "string",
          "minLength": 1
        },
        "offsetDays": {
          "type": "integer"
        }
      }
    },
    "rolloutPlan": {
      "type": "object",
      "required": [
        "kind",
        "templateVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "rollout"
        },
        "preset": {
          "enum": [
            "generic",
            "dataMigration"
          ],
          "description": "The preset the rollout was made from, for the checks it adds."
        },
        "templateVersion": {
          "type": "integer",
          "minimum": 1
        },
        "milestones": {
          "type": "array",
          "description": "Ordered: the site phase is derived walking them in this order.",
          "items": {
            "$ref": "#/$defs/milestone"
          }
        },
        "template": {
          "type": "array",
          "description": "The scope template: change entries written relative to a site, in order.",
          "items": {
            "$ref": "#/$defs/templateChange"
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "blackouts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/blackout"
              }
            },
            "defaultCapacity": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "archetypes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/archetype"
          }
        },
        "sites": {
          "type": "array",
          "description": "One plan per Location, sorted by location id.",
          "items": {
            "$ref": "#/$defs/sitePlan"
          }
        }
      }
    },
    "wavePlan": {
      "type": "object",
      "required": [
        "kind",
        "rollout",
        "label",
        "order",
        "templateVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "wave"
        },
        "rollout": {
          "type": "string",
          "minLength": 1,
          "description": "id of the rollout Work Package that aggregates the wave"
        },
        "label": {
          "type": "string"
        },
        "order": {
          "type": "integer"
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": {
              "$ref": "#/$defs/planDate"
            },
            "end": {
              "$ref": "#/$defs/planDate"
            }
          }
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of sites."
        },
        "templateVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "The template version the wave is locked to."
        },
        "milestones": {
          "type": "object",
          "description": "The dates the wave's sites inherit when they set none of their own, by milestone id.",
          "additionalProperties": {
            "$ref": "#/$defs/planDate"
          }
        }
      }
    },
    "milestone": {
      "type": "object",
      "required": [
        "id",
        "label",
        "startsPhase"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "startsPhase": {
          "enum": [
            "planned",
            "preparing",
            "cutover",
            "hypercare",
            "migrated",
            "done"
          ]
        },
        "date": {
          "$ref": "#/$defs/planDate",
          "description": "The rollout's own date for the milestone, which a site inherits when neither it nor its wave sets one."
        }
      }
    },
    "changeEntry": {
      "type": "object",
      "description": "A change entry (ADR 0014): it dates something in the model. A site's own change, in an 'add' exception.",
      "required": [
        "id",
        "kind",
        "subject",
        "date"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "introduce",
            "retire",
            "replace",
            "add",
            "remove",
            "modify"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "description": "id of the element or relationship it dates"
        },
        "successor": {
          "type": "string",
          "minLength": 1,
          "description": "kind 'replace': id of the element that replaces subject"
        },
        "field": {
          "enum": [
            "functionalFit",
            "technicalFit",
            "timeClassification"
          ]
        },
        "value": {
          "description": "kind 'modify': the planned value of field",
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            {
              "enum": [
                "Tolerate",
                "Invest",
                "Migrate",
                "Eliminate"
              ]
            }
          ]
        },
        "date": {
          "oneOf": [
            {
              "$ref": "#/$defs/planDate"
            },
            {
              "$ref": "#/$defs/anchoredDate"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "replace"
              }
            }
          },
          "then": {
            "required": [
              "successor"
            ]
          },
          "else": {
            "not": {
              "required": [
                "successor"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "modify"
              }
            }
          },
          "then": {
            "required": [
              "field",
              "value"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "field"
                  ]
                },
                {
                  "required": [
                    "value"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "templateChange": {
      "type": "object",
      "description": "A change entry (ADR 0014): it dates something in the model, here relative to each site it applies to.",
      "required": [
        "id",
        "kind",
        "subject",
        "date",
        "applicability"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "introduce",
            "retire",
            "replace",
            "add",
            "remove",
            "modify"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "description": "id of the element or relationship it dates"
        },
        "successor": {
          "type": "string",
          "minLength": 1,
          "description": "kind 'replace': id of the element that replaces subject"
        },
        "field": {
          "enum": [
            "functionalFit",
            "technicalFit",
            "timeClassification"
          ]
        },
        "value": {
          "description": "kind 'modify': the planned value of field",
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            {
              "enum": [
                "Tolerate",
                "Invest",
                "Migrate",
                "Eliminate"
              ]
            }
          ]
        },
        "date": {
          "oneOf": [
            {
              "$ref": "#/$defs/planDate"
            },
            {
              "$ref": "#/$defs/anchoredDate"
            }
          ]
        },
        "applicability": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "all"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "kind",
                "archetypes"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "archetypes"
                },
                "archetypes": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "kind",
                "element"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "aggregating"
                },
                "element": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "replace"
              }
            }
          },
          "then": {
            "required": [
              "successor"
            ]
          },
          "else": {
            "not": {
              "required": [
                "successor"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "modify"
              }
            }
          },
          "then": {
            "required": [
              "field",
              "value"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "field"
                  ]
                },
                {
                  "required": [
                    "value"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "archetype": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "durations": {
          "type": "object",
          "description": "Default days from the previous milestone, by milestone id.",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "blackout": {
      "type": "object",
      "description": "A period no cutover should fall in, both days inclusive.",
      "required": [
        "id",
        "start",
        "end"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "start": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "sitePlan": {
      "type": "object",
      "description": "One Location's plan within its rollout.",
      "required": [
        "location"
      ],
      "additionalProperties": false,
      "properties": {
        "location": {
          "type": "string",
          "minLength": 1,
          "description": "id of the Location element"
        },
        "wave": {
          "type": "string",
          "minLength": 1,
          "description": "id of a wave of the same rollout; absent is unassigned"
        },
        "archetype": {
          "type": "string",
          "minLength": 1,
          "description": "id of an archetype of the rollout"
        },
        "milestones": {
          "type": "object",
          "description": "Planned dates that override the inherited ones, by milestone id.",
          "additionalProperties": {
            "$ref": "#/$defs/planDate"
          }
        },
        "actuals": {
          "type": "object",
          "description": "The day each milestone was actually reached, by milestone id.",
          "additionalProperties": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "rag": {
          "enum": [
            "green",
            "amber",
            "red"
          ]
        },
        "goNoGo": {
          "enum": [
            "go",
            "no-go"
          ],
          "description": "The decision taken at the go/no-go gate; absent is not decided yet."
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "exceptions": {
          "type": "array",
          "description": "Its deviations from the template, sorted by id; ids are unique in the rollout.",
          "items": {
            "$ref": "#/$defs/siteException"
          }
        },
        "dependsOn": {
          "type": "array",
          "description": "Location ids of the sites of the same rollout that cut over before it, sorted.",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blackouts": {
          "type": "array",
          "description": "Its own blackouts, besides the rollout's, sorted by id.",
          "items": {
            "$ref": "#/$defs/blackout"
          }
        }
      }
    },
    "siteException": {
      "type": "object",
      "description": "A site's deviation from the template: 'skip' a template change, 'modify' its offset or disposition, or 'add' a change of the site's own.",
      "required": [
        "id",
        "kind",
        "change",
        "class"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "skip",
            "add",
            "modify"
          ]
        },
        "change": {
          "description": "kinds 'skip' and 'modify': the id of a template change; kind 'add': the site's own change entry",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "$ref": "#/$defs/changeEntry"
            }
          ]
        },
        "class": {
          "enum": [
            "legal",
            "operational",
            "preference"
          ]
        },
        "owner": {
          "type": "string"
        },
        "expires": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "The last day it holds."
        },
        "rationale": {
          "type": "string"
        },
        "offsetDays": {
          "type": "integer",
          "description": "kind 'modify': whole days from the change's anchor at this site"
        },
        "disposition": {
          "enum": [
            "migrate",
            "archive",
            "purge",
            "retain"
          ],
          "description": "kind 'modify': what becomes of the data at this site"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "add"
              }
            }
          },
          "then": {
            "properties": {
              "change": {
                "$ref": "#/$defs/changeEntry"
              }
            }
          },
          "else": {
            "properties": {
              "change": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "modify"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "offsetDays"
                ]
              },
              {
                "required": [
                  "disposition"
                ]
              }
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "offsetDays"
                  ]
                },
                {
                  "required": [
                    "disposition"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "relationship": {
      "type": "object",
      "required": [
        "id",
        "type",
        "source",
        "target"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
        },
        "type": {
          "enum": [
            "Composition",
            "Aggregation",
            "Assignment",
            "Realization",
            "Serving",
            "Access",
            "Influence",
            "Triggering",
            "Flow",
            "Specialization",
            "Association"
          ]
        },
        "source": {
          "type": "string",
          "description": "id of the source element"
        },
        "target": {
          "type": "string",
          "description": "id of the target element"
        },
        "name": {
          "type": "string"
        },
        "documentation": {
          "type": "string"
        },
        "isDirected": {
          "type": "boolean",
          "description": "Association only. true draws a half-arrowhead at the target; absent (or false) is undirected."
        },
        "modifier": {
          "type": "string",
          "minLength": 1,
          "description": "Influence only. The strength: ++, +, 0, -, --, or any other text such as a number on a scale."
        },
        "properties": {
          "$ref": "#/$defs/properties"
        },
        "profile": {
          "$ref": "#/$defs/relationshipProfile"
        },
        "folder": {
          "$ref": "#/$defs/folderRef"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "isDirected"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "Association"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "modifier"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "Influence"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "profile"
            ],
            "properties": {
              "profile": {
                "required": [
                  "accessType"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "type": {
                "const": "Access"
              }
            }
          }
        }
      ]
    },
    "properties": {
      "type": "object",
      "description": "Free-form ArchiMate properties.",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "portfolioProfile": {
      "type": "object",
      "description": "LeanIX-style assessment overlay. Serialises as namespaced ArchiMate properties in the exchange format, so it survives a round trip through any certified tool.",
      "additionalProperties": false,
      "properties": {
        "lifecycle": {
          "type": "object",
          "description": "The date each phase starts, ISO 8601. The current phase is derived from these at a time point and is never stored.",
          "additionalProperties": false,
          "properties": {
            "plan": {
              "type": "string",
              "format": "date",
              "examples": [
                "2027-01-01"
              ]
            },
            "phaseIn": {
              "type": "string",
              "format": "date",
              "examples": [
                "2027-01-01"
              ]
            },
            "active": {
              "type": "string",
              "format": "date",
              "examples": [
                "2027-01-01"
              ]
            },
            "phaseOut": {
              "type": "string",
              "format": "date",
              "examples": [
                "2027-01-01"
              ]
            },
            "endOfLife": {
              "type": "string",
              "format": "date",
              "examples": [
                "2027-01-01"
              ]
            }
          }
        },
        "functionalFit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "technicalFit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "businessCriticality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "description": "1 = Low, 2 = Medium, 3 = High, 4 = Critical"
        },
        "timeClassification": {
          "enum": [
            "Tolerate",
            "Invest",
            "Migrate",
            "Eliminate"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "relationshipProfile": {
      "type": "object",
      "description": "Fields carried by the relationship itself — cost, support type and validity dates belong on the edge, not on either endpoint.",
      "additionalProperties": false,
      "properties": {
        "annualCost": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string"
        },
        "supportType": {
          "type": "string"
        },
        "validFrom": {
          "type": "string",
          "format": "date"
        },
        "validTo": {
          "type": "string",
          "format": "date"
        },
        "accessType": {
          "enum": [
            "Access",
            "Read",
            "Write",
            "ReadWrite"
          ],
          "description": "Access relationships only."
        }
      }
    },
    "folderRef": {
      "type": "string",
      "description": "id of the folder this object is filed in. Absent means the default group for its kind."
    },
    "folder": {
      "type": "object",
      "description": "User organisation of the model tree; no semantics. Exactly one of parent and root is set.",
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "documentation": {
          "type": "string"
        },
        "parent": {
          "type": "string",
          "description": "id of the enclosing folder"
        },
        "root": {
          "enum": [
            "strategy",
            "business",
            "application",
            "technology",
            "motivation",
            "implementation",
            "other",
            "relations",
            "views"
          ],
          "description": "The fixed top-level group a top-level folder sits in."
        }
      },
      "oneOf": [
        {
          "required": [
            "parent"
          ]
        },
        {
          "required": [
            "root"
          ]
        }
      ]
    },
    "view": {
      "type": "object",
      "description": "A hand-drawn diagram.",
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "documentation": {
          "type": "string"
        },
        "viewpoint": {
          "type": "string",
          "description": "ArchiMate viewpoint name."
        },
        "router": {
          "const": "manhattan",
          "description": "Connections drawn in horizontal and vertical segments, ignoring their bend-points. Absent means through the bend-points."
        },
        "folder": {
          "$ref": "#/$defs/folderRef"
        },
        "properties": {
          "$ref": "#/$defs/properties"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/viewNode"
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/viewConnection"
          }
        }
      }
    },
    "bounds": {
      "type": "object",
      "description": "Position relative to the parent node (or the view), and size.",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "appearance": {
      "type": "object",
      "description": "Overrides of the notation's default look. Absent fields mean the default.",
      "additionalProperties": false,
      "properties": {
        "fillColor": {
          "$ref": "#/$defs/colour"
        },
        "lineColor": {
          "$ref": "#/$defs/colour"
        },
        "lineWidth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fontName": {
          "type": "string",
          "minLength": 1
        },
        "fontSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "fontColor": {
          "$ref": "#/$defs/colour"
        },
        "fontStyle": {
          "type": "array",
          "items": {
            "enum": [
              "bold",
              "italic",
              "underline",
              "strikethrough"
            ]
          }
        },
        "textAlignment": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "textPosition": {
          "enum": [
            "top",
            "middle",
            "bottom"
          ]
        },
        "labelPosition": {
          "enum": [
            "source",
            "middle",
            "target"
          ],
          "description": "Where a connection's label sits along it. Absent means the middle."
        }
      }
    },
    "colour": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
    },
    "viewNode": {
      "type": "object",
      "description": "A diagram object: a drawn element, a note, a group, a view reference or a legend.",
      "required": [
        "id",
        "kind",
        "bounds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique within its view."
        },
        "kind": {
          "enum": [
            "element",
            "note",
            "group",
            "view-ref",
            "legend"
          ]
        },
        "bounds": {
          "$ref": "#/$defs/bounds"
        },
        "parent": {
          "type": "string",
          "description": "id of the enclosing node in the same view"
        },
        "appearance": {
          "$ref": "#/$defs/appearance"
        },
        "element": {
          "type": "string",
          "description": "kind 'element': id of the element drawn"
        },
        "text": {
          "type": "string",
          "description": "kind 'note'"
        },
        "name": {
          "type": "string",
          "description": "kind 'group'; kind 'legend', which draws it nowhere"
        },
        "documentation": {
          "type": "string",
          "description": "kind 'group'"
        },
        "view": {
          "type": "string",
          "description": "kind 'view-ref': id of the view referenced"
        },
        "options": {
          "$ref": "#/$defs/legendOptions"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "element"
              }
            }
          },
          "then": {
            "required": [
              "element"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "note"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "group"
              }
            }
          },
          "then": {
            "required": [
              "name"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "view-ref"
              }
            }
          },
          "then": {
            "required": [
              "view"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "legend"
              }
            }
          },
          "then": {
            "required": [
              "options"
            ]
          }
        }
      ]
    },
    "legendOptions": {
      "type": "object",
      "description": "kind 'legend': what it lists and how, as Archi's ILegendOptions. Its entries are not stored; they follow the view.",
      "required": [
        "elements",
        "relations",
        "specializedElements",
        "specializedRelations",
        "rowsPerColumn",
        "widthOffset",
        "colours",
        "sort"
      ],
      "additionalProperties": false,
      "properties": {
        "elements": {
          "type": "boolean"
        },
        "relations": {
          "type": "boolean"
        },
        "specializedElements": {
          "type": "boolean"
        },
        "specializedRelations": {
          "type": "boolean"
        },
        "rowsPerColumn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "widthOffset": {
          "type": "integer",
          "minimum": -200,
          "maximum": 200
        },
        "colours": {
          "enum": [
            "none",
            "core",
            "user"
          ]
        },
        "sort": {
          "enum": [
            "name",
            "category"
          ]
        }
      }
    },
    "viewConnection": {
      "type": "object",
      "description": "A drawn relationship, or a plain line between notes and groups.",
      "required": [
        "id",
        "kind",
        "source",
        "target"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique within its view."
        },
        "kind": {
          "enum": [
            "relationship",
            "line"
          ]
        },
        "source": {
          "type": "string",
          "description": "id of the source node"
        },
        "target": {
          "type": "string",
          "description": "id of the target node"
        },
        "bendpoints": {
          "type": "array",
          "description": "Route corners from source to target, in view coordinates.",
          "items": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          }
        },
        "appearance": {
          "$ref": "#/$defs/appearance"
        },
        "relationship": {
          "type": "string",
          "description": "kind 'relationship': id of the relationship drawn"
        },
        "name": {
          "type": "string",
          "description": "kind 'line'"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "relationship"
              }
            }
          },
          "then": {
            "required": [
              "relationship"
            ]
          }
        }
      ]
    },
    "report": {
      "type": "object",
      "description": "A saved report definition.",
      "required": [
        "id",
        "name",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "graph",
            "capability-map",
            "landscape",
            "matrix",
            "roadmap",
            "portfolio"
          ]
        },
        "baseType": {
          "enum": [
            "Resource",
            "Capability",
            "CourseOfAction",
            "ValueStream",
            "BusinessActor",
            "BusinessRole",
            "BusinessCollaboration",
            "BusinessInterface",
            "BusinessProcess",
            "BusinessFunction",
            "BusinessInteraction",
            "BusinessEvent",
            "BusinessService",
            "BusinessObject",
            "Contract",
            "Representation",
            "Product",
            "ApplicationComponent",
            "ApplicationCollaboration",
            "ApplicationInterface",
            "ApplicationFunction",
            "ApplicationInteraction",
            "ApplicationProcess",
            "ApplicationEvent",
            "ApplicationService",
            "DataObject",
            "Node",
            "Device",
            "SystemSoftware",
            "TechnologyCollaboration",
            "TechnologyInterface",
            "Path",
            "CommunicationNetwork",
            "TechnologyFunction",
            "TechnologyProcess",
            "TechnologyInteraction",
            "TechnologyEvent",
            "TechnologyService",
            "Artifact",
            "Equipment",
            "Facility",
            "DistributionNetwork",
            "Material",
            "Stakeholder",
            "Driver",
            "Assessment",
            "Goal",
            "Outcome",
            "Principle",
            "Requirement",
            "Constraint",
            "Meaning",
            "Value",
            "WorkPackage",
            "Deliverable",
            "ImplementationEvent",
            "Plateau",
            "Gap",
            "Location",
            "Grouping",
            "Junction"
          ]
        },
        "filter": {
          "type": "object",
          "properties": {
            "facets": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "mode": {
              "enum": [
                "AND",
                "OR",
                "NOT"
              ]
            },
            "query": {
              "type": "string"
            }
          }
        },
        "cluster": {
          "type": "string"
        },
        "drilldown": {
          "type": "string"
        },
        "colorView": {
          "enum": [
            "layer",
            "lifecycle",
            "time"
          ]
        },
        "timePoint": {
          "type": "integer"
        }
      }
    },
    "tagGroup": {
      "type": "object",
      "required": [
        "id",
        "name",
        "tags"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "multiSelect": {
          "type": "boolean"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "colourToken": {
                "type": "string",
                "description": "CSS custom property carrying the tag colour."
              }
            }
          }
        }
      }
    }
  }
}
